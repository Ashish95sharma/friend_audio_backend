NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/friend_audio
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_to_another_long_random_secret
REFRESH_TOKEN_EXPIRES_IN=30d
CLIENT_ORIGIN=http://localhost:3000
WS_PATH=/ws
API_PREFIX=
STUN_URL=stun:stun.l.google.com:19302

# --- Recommended: Metered TURN (works across different networks) ---
# 1) Sign up at https://dashboard.metered.ca
# 2) Create a TURN credential → copy Domain + API Key
# 3) Set these on Render (and locally if testing):
METERED_DOMAIN=
METERED_TURN_API_KEY=

# --- Optional fallback: static TURN URLs (comma-separated) ---
# TURN_URL=turn:a.relay.metered.ca:80,turn:a.relay.metered.ca:443
# TURN_USERNAME=
# TURN_PASSWORD=
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
REQUESTING_TIMEOUT_MS=60000
CONNECTING_TIMEOUT_MS=120000
HEARTBEAT_INTERVAL_MS=30000
